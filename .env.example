DATABASE_URL="postgresql://menu:menu@localhost:5432/tablebabu?schema=public"
POSTGRES_DB=tablebabu
APP_ORIGIN="http://localhost:3000"
PORT=3000
# Set only when there is exactly one trusted reverse proxy in front of the app.
TRUST_PROXY=0
# Enable safe transaction timings and runtime/pool samples in local or staging runs.
ORDER_DIAGNOSTICS=0
# Optional permanent code for npm run restaurant:create; omit for an assigned code.
# RESTAURANT_ORDER_CODE=AMAN
# Required to provision a restaurant with npm run db:seed. No default password.
SEED_EMAIL="owner@bengalbistro.com"
SEED_PASSWORD=""
# One-time platform administrator provisioning: npm run admin:create.
# Use a NEW email; existing owner accounts are never silently promoted.
# Remove PLATFORM_ADMIN_PASSWORD from the environment after provisioning.
PLATFORM_ADMIN_NAME="Debojyoti"
PLATFORM_ADMIN_EMAIL="sinhadebojyoti127@gmail.com"
PLATFORM_ADMIN_PASSWORD="Iman221@@@360"
